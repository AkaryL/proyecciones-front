# Datos: los sirve el back (proyecciones-backend). Lo que generan los scripts
# del motor es salida local que se importa al almacén del back, no se versiona.
public/data/*
src/data/generated

# Excepción: los JSON del motor que leen Territorio, Comparativo y Fuentes
# (src/motor). El back todavía no los sirve, así que de momento van con el front;
# cuando los sirva, se apunta VITE_MOTOR_URL a la API y esta carpeta deja de
# versionarse (ver README).
!public/data/motor/
