# Base de la API (repositorio proyecciones-backend, puerto 3400 por omisión).
# Copia este archivo a .env.local y ajusta la dirección si hace falta.
VITE_API_URL=http://localhost:3400/api/proyecciones

# De dónde leen Territorio, Comparativo y Fuentes los JSON del motor. Sin esta
# variable salen de la copia que va con el front (public/data/motor). Se
# descomenta cuando el back ya los sirva (cada archivo por su nombre).
# VITE_MOTOR_URL=http://localhost:3400/api/proyecciones/motor
